# SentinelForge Environment Configuration Template
# Copy this file to .env for local development

# Environment: development | testing | production
FLASK_ENV=development
FLASK_DEBUG=1

# Server Settings
HOST=127.0.0.1
PORT=5000

# Security (Change for production)
SECRET_KEY=dev-insecure-secret-key-change-in-production

# Database (PostgreSQL for development/production, SQLite for testing)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sentinelforge

# Logging: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=DEBUG

# SQLAlchemy Echo (development only): True | False
SQLALCHEMY_ECHO=False
